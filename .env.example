# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
TZ=UTC
MODE=development
PORT=8020
API_BASEURL=http://localhost:8020/api
FRONTEND_BASEURL=http://localhost:3020
# Comma separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3020
# Default timezone used for shift windows and reminders
APP_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/lms

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-64-hex-chars
JWT_ACCESS_TOKEN_EXPIRE=15m
JWT_REFRESH_SECRET=change-me-64-hex-chars
# Session hard limit: user must log in again after this
JWT_REFRESH_TOKEN_EXPIRE=12h
# Failed logins before the account is locked, and lock duration
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_EXPIRE_MINUTES=10

# 32 byte key / 16 byte iv, hex encoded (aes-256-cbc)
ENCRYPT_KEY=change-me-64-hex-chars
ENCRYPT_IV=change-me-32-hex-chars
# Secret used to sign short lived file URLs
FILE_URL_SECRET=change-me-64-hex-chars

# -----------------------------------------------------------------------------
# Shift based access
# -----------------------------------------------------------------------------
# Minutes of access allowed before shift start / after shift end
SHIFT_GRACE_MINUTES=15

# -----------------------------------------------------------------------------
# Bunny Stream (video)
# -----------------------------------------------------------------------------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Read-only API key, used to verify webhook signatures
BUNNY_STREAM_READ_ONLY_API_KEY=
# Pull zone hostname of the library, e.g. vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
# Pull zone > Security > Token authentication key
BUNNY_STREAM_TOKEN_KEY=
# Signed playback URL lifetime (seconds), capped at shift end
VIDEO_TOKEN_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# File uploads (images / PDF)
# -----------------------------------------------------------------------------
STORAGE_PATH=storage
UPLOAD_MAX_MB=25

# -----------------------------------------------------------------------------
# Mail (SMTP). Leave MAIL_HOST empty to log mails instead of sending
# -----------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Indoventura Training <training@example.com>"

# -----------------------------------------------------------------------------
# SMS for OTP. console = log OTP to server logs (development)
# -----------------------------------------------------------------------------
SMS_PROVIDER=console

# -----------------------------------------------------------------------------
# Reminders
# -----------------------------------------------------------------------------
# Cron expression (APP_TIMEZONE) for deadline / overdue reminders
REMINDER_CRON=0 9 * * *
REMINDER_DAYS_BEFORE_DUE=2

# -----------------------------------------------------------------------------
# Seed (npm run db:seed). Password for the seeded super admin (must be changed on
# first login) and for demo users (npm run db:seed -- --demo, development only)
# -----------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=change-me-Admin1
SEED_DEMO_PASSWORD=change-me-Demo1
