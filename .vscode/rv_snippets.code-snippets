	"controller-file": {
		"prefix": [
			"controller-file"
		],
		"body": [
			"import { Request, Response } from 'express'",
			"",
			"import { sendResponse } from '@core/services/ResponseService'",
			"import statusType from '@core/enum/statusTypes'",
			"import logger from '@core/services/LoggingService'",
			"",
			"export async function $0${1:Function}(req: Request, res: Response) {",
			"    try {",
			"        ${4:}",
			"",
			"        return sendResponse(res, true, null, '${2:success}')",
			"    } catch (error) {",
			"        logger.consoleErrorLog(req.originalUrl, 'Error in $0${1:Function}', error)",
			"        return sendResponse(res, false, null, 'Error ${3:}', statusType.DB_ERROR)",
			"    }",
			"}"
		],
		"description": "Controller File"
	},
	"controller": {
		"prefix": [
